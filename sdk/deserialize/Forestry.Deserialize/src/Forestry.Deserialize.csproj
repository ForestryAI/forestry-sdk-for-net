<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Forestry Deserialize</Description>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <Version>1.0.0-beta.1</Version>
    <ComptableVersion>1.0.0</ComptableVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageTags>Forestry Deserialize</PackageTags>
  </PropertyGroup>

  <!-- Public documentation (D0), option B (R9): XML docs on, missing docs warn until the first real StanForD document -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Forestry.Deserialize.Xml</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Forestry.Deserialize.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
