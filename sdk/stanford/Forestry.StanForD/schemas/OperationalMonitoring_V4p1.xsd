					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Order number of the shift (First order is 1, seciond is 2 and so on)</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ShiftCategory" type="ShiftCategoryType" minOccurs="0">
