							<doc:Description>Structure with maintenance reasons</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Disturbance" type="DisturbanceType">
					<xsd:annotation>
						<xsd:documentation>
