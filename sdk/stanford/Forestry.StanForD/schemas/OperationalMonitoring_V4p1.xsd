										<doc:VersionCreated>4.0</doc:VersionCreated>
										<doc:Unit>free text</doc:Unit>
										<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
									</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="HydraulicsCode">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>4.0</doc:VersionModified>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration list with hydraulic repair reasons. According to code list in mcl file.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="xsd:string">
							<xsd:attribute name="hydraulicsName" type="xsd:string">
								<xsd:annotation>
									<xsd:documentation>
										<doc:VersionCreated>4.0</doc:VersionCreated>
										<doc:Unit>free text</doc:Unit>
										<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
									</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="MechanicalCode">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>4.0</doc:VersionModified>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration list with mechanical repair reasons. According to code list in mcl file.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="xsd:string">
							<xsd:attribute name="mechanicalName" type="xsd:string">
								<xsd:annotation>
									<xsd:documentation>
										<doc:VersionCreated>4.0</doc:VersionCreated>
										<doc:Unit>free text</doc:Unit>
										<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
									</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="MachineDownTimeType">
