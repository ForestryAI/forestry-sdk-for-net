				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>3.5</doc:VersionModified>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration list with reason for other machine down times. According to code list in mcl file. Observe that the value “ControllerDefault” can be used in cases where operators have not registered any reason at all. 
This value is not to be included in the mcl-file. “ControllerDefault” not to be available in GUI and only generated by control system. “ControllerDefault” to be used in system where down time reasons are disabled or there is a “time-out”.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="xsd:string">
							<xsd:attribute name="otherMachineDownTimeStandardName" type="xsd:string">
								<xsd:annotation>
									<xsd:documentation>
										<doc:VersionCreated>4.0</doc:VersionCreated>
										<doc:Unit>free text</doc:Unit>
										<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
									</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OtherMachineDownTimeManufacturerCode" type="ManufacturerCodeType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Manufacturer or user defined codes.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="RepairType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>RepairTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="CarrierRepairReason" type="CarrierRepairReasonType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Description>Structure with repair reasons for carrier / base machine</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="LoaderLinkageRepairReason" type="LoaderLinkageRepairReasonType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Description>Structure with repair reasons for loader or linkage.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="AttachmentRepairReason" type="AttachmentRepairReasonType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Description>Repair resons for harvesting head.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="OtherRepairReason">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:VersionModified>4.0</doc:VersionModified>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Enumeration list with other repair reasons. According to code list in mcl file.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:simpleContent>
							<xsd:extension base="xsd:string">
								<xsd:attribute name="otherRepairReasonName" type="xsd:string">
									<xsd:annotation>
										<xsd:documentation>
											<doc:VersionCreated>4.0</doc:VersionCreated>
											<doc:Unit>free text</doc:Unit>
											<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
										</xsd:documentation>
									</xsd:annotation>
								</xsd:attribute>
							</xsd:extension>
						</xsd:simpleContent>
					</xsd:complexType>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="RepairManufacturerCode" type="ManufacturerCodeType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Manufacturer or user defined codes for repair reasons</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="ReportIntervalType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>ReportIntervalTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ReportStartTime" type="StanForD2010DateTimeType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V53_t1</doc:VarNumber>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Start date for monitoring report. Use ReportStartTime and ReportEndTime to calculate calender time. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ReportEndTime" type="StanForD2010DateTimeType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V53_t2</doc:VarNumber>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>End date for monitoring report. Use ReportStartTime and ReportEndTime to calculate calender time. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ReportFilterCategory" type="ReportFilterCategoryType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.1</doc:VersionCreated>
						<doc:VersionModified>3.0</doc:VersionModified>
						<doc:Unit>tlist</doc:Unit>
						<doc:Description>Possible enumeration values are: "No filter", "Object filter" and "Other filter". No filter” means that “All run (work) times, down times and meal breaks that occurred between ReportStartTime and ReportEndTime are included, with no exceptions. This means that any times not registered are to be considered to be unutilized.” The value “Object filter” means that only times directly connected to a specific object are included. </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="ShortDownTimeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:VersionModified>4.0</doc:VersionModified>
				<doc:Graph>ShortDownTimeTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OperatorKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine unique operator identity, set by machine</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="IndividualMachineWorkTimeKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per individual machine work time. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed. </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ObjectKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting object. Set when new harvesting object is started. Running no recommended, reset only when MachineKey is changed</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SubObjectKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting sub object, set by machine. Set when new harvesting sub object is started. Running no recommended, reset when ObjectKey is updated.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SparePartsType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>SparePartsTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="SparePartIdentity" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Identity information of the spare part</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SparePartDescription" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Descriptive information of the spare part</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SparePartsNoOfItems" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:Description>Number of spare parts</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SpeciesGroupDefinitionOperationalMonitoringType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.0</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionOperationalMonitoringTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="CommonSpeciesGroupDefinitionType">
				<xsd:sequence>
					<xsd:element name="DBHHeight" type="DBHHeightType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VarNumber>v500_t1</doc:VarNumber>
								<doc:Unit>cm</doc:Unit>
								<doc:Description>Height above stump of DBH, when DBH is a measured value (normally 120 cm above stump in Sweden, 110cm in Norway), per species group.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="Grades" type="GradesType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure with alla grade data per species group</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="BarkFunction" type="BarkFunctionWithKeyType" nillable="true" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for species included in a species group.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SoundKnotFunction" type="SoundKnotFunctionType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Sound knot function used when calculating the diameter (ob) of the sound knot limit/cylinder. Soundknot function must be used if this structure is included. Observe that all diameters are over bark. </doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ButtEndProfileExtrapolation" type="ButtEndProfileExtrapolationType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for butt end profile extrapolation method. Extrapolation method must be used if this structure is included in spi.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="EstonianVolumeParameters" type="EstonianVolumeParametersType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>2.0</doc:VersionCreated>
								<doc:Description>Structure for parameters used in Estonian function for volume calculation. This function is also called  Nilson's formula. See appendix</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="StemCodes" type="StemCodesType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.0</doc:VersionCreated>
								<doc:Unit>Free text</doc:Unit>
								<doc:Description>List of stem codes to be registered manually by operator in harvester in element StemCode in hpr-message</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SpeciesGroupKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per species group set by machine. Must be updated if any modifications to species group definition is done. Running number reset only when MachineKey is changed.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="TotalForwardedVolumeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>TotalForwardedVolumeTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="VolumeType">
				<xsd:attribute name="forwardedVolumeCategory" type="ForwardedVolumeCategoryType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Defines volume registered in TotalForwardedVolume. Allowed values: "Volume, m3sob", "Volume, m3sub", "Loose volume, m3", "Solid volume including bark, branches and needles, m3", "Solid volume of bundles (length*cross sectional area), m3"</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="TotalVolumeOfHarvestedLogsType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>TotalVolumeOfHarvestedLogsTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="VolumeType">
				<xsd:attribute name="harvestedLogsVolumeCategory" type="HarvestedLogsVolumeCategoryType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Allowed values: "m3sob", "m3sub", "m3sobEstimated", "m3subEstimated"</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="TrackCoordinatesOperationalMonitoringType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>TrackCoordinatesForwardedProductionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="TrackCoordinatesType">
				<xsd:sequence>
					<xsd:element name="IndividualMachineWorkTimeKey" type="KeyType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per individual machine work time. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed. </doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="UserDefinedDataOperationalMonitoringType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>2.1</doc:VersionCreated>
				<doc:Graph>UserDefinedDataOperationalMonitoringTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DataTableGroup" type="DataTableGroupOperationalMonitoringType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.1</doc:VersionCreated>
						<doc:Description>Structure for user defined data table group</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:unique name="UniqueTableIDHOperationalMonitoring">
					<xsd:selector xpath="sfd:DataTable"/>
					<xsd:field xpath="@tableID"/>
				</xsd:unique>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="ForwardedVolumeCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Volume, m3sob"/>
			<xsd:enumeration value="Volume, m3sub"/>
			<xsd:enumeration value="Loose volume, m3"/>
			<xsd:enumeration value="Solid volume including bark, branches and needles, m3"/>
			<xsd:enumeration value="Solid volume of bundles (length*cross sectional area), m3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="HarvestedLogsVolumeCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="m3sob"/>
			<xsd:enumeration value="m3sub"/>
			<xsd:enumeration value="m3sobEstimated"/>
			<xsd:enumeration value="m3subEstimated"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="MachineRunTimeCategoryListType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Processing"/>
			<xsd:enumeration value="Terrain travel"/>
			<xsd:enumeration value="Other work"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="OperatorLoginEventCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Login"/>
			<xsd:enumeration value="Logout"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="ReportFilterCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="No filter"/>
			<xsd:enumeration value="Object filter"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="ShiftCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Not defined"/>
			<xsd:enumeration value="Morning"/>
			<xsd:enumeration value="Day"/>
			<xsd:enumeration value="Evening"/>
			<xsd:enumeration value="Night"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
