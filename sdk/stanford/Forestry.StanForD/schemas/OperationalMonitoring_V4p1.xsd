	</xsd:complexType>
	<xsd:complexType name="MachineOperationalMonitoringType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>MachineOperationalMonitoringTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="MachineWithAttachmentType">
				<xsd:sequence>
					<xsd:element name="SpeciesGroupDefinition" type="SpeciesGroupDefinitionOperationalMonitoringType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Definition of species used in this operational monitoring message</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ObjectDefinition" type="ObjectDefinitionMachineType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for object specific data</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueSubObjectKey">
							<xsd:selector xpath="sfd:SubObject"/>
							<xsd:field xpath="sfd:SubObjectKey"/>
						</xsd:unique>
						<xsd:unique name="UniqueSubObjectUserIDMachineOperationalMonitoring">
							<xsd:selector xpath="sfd:SubObject"/>
							<xsd:field xpath="sfd:SubObjectUserID"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="CodeListDefinition" type="CodeListDefinitionType" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>Structure for code list. Can be distributed to machine using mcl-fil.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="IndividualMachineWorkTime" type="IndividualMachineWorkTimeType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for machine work times including run, down and unutilized times.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="OperatorLoginEvent" type="OperatorLoginEventType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>Structure for register when operator is logged into or out of machine software system.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="OperatorShiftDefinition" type="OperatorShiftDefinitionType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>2.0</doc:VersionCreated>
								<doc:Description>Structure for operator shifts</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="OperatorWorkTime" type="OperatorWorkTimeType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for operator work times, including work outside machine.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ReportInterval" type="ReportIntervalType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Total time interval covered by the mom file.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="MonitoringSettings" type="MonitoringSettingsType" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VersionModified>2.0</doc:VersionModified>
								<doc:Description>Structure for monitoring filter times.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="MachineEngineTime" type="xsd:nonNegativeInteger">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VersionModified>2.0</doc:VersionModified>
								<doc:VarNumber>v431_t1</doc:VarNumber>
								<doc:Unit>minutes</doc:Unit>
								<doc:Description>Total engine time, covering total life time of the engine up until the time of the report end time.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="MachineDrivenDistance" type="xsd:nonNegativeInteger">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>m</doc:Unit>
								<doc:Description>Total distance covering the total life time of the machine up until the time of the report end time.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="MachineFuelConsumption" type="xsd:nonNegativeInteger">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>litre</doc:Unit>
								<doc:Description>Total fuel consumption covering the total life time of the machine up until the time of the report end time.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="IndividualShortDownTime" type="IndividualShortDownTimeType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for individual short down times. Not aggregated.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="UserDefinedData" type="UserDefinedDataOperationalMonitoringType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>2.1</doc:VersionCreated>
								<doc:Description>Structure for user defined data</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueTableGroupIDUserDefinedDataOperationalMonitoring">
							<xsd:selector xpath="sfd:DataTableGroup"/>
							<xsd:field xpath="@tableGroupID"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="IndividualEngineTime" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.5</doc:VersionCreated>
								<doc:Description>Structure for engine times, based on when engine is turned on and off. No aggregations.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="EngineStartTime" type="StanForD2010DateTimeType">
									<xsd:annotation>
										<xsd:documentation>
											<doc:VersionCreated>3.5</doc:VersionCreated>
											<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
											<doc:Description>Start time for a time interval, when engine is turned on. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
										</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="EngineTimeLength" type="xsd:positiveInteger">
									<xsd:annotation>
										<xsd:documentation>
											<doc:VersionCreated>3.5</doc:VersionCreated>
											<doc:Unit>seconds</doc:Unit>
											<doc:Description>Extension of a time interval during which engine is turned on.</doc:Description>
										</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>
											<doc:VersionCreated>1.0</doc:VersionCreated>
											<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
										</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="TrackCoordinates" type="TrackCoordinatesOperationalMonitoringType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>Structure for track coordinates</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="MachineRunTimeCategoryType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>2.0</doc:VersionCreated>
				<doc:Graph>MachineRunTimeCategoryTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="MachineRunTimeCategoryListType">
				<xsd:attribute name="otherWorkCategoryCode" type="xsd:string">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>2.0</doc:VersionCreated>
							<doc:VersionModified>4.0</doc:VersionModified>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Enumeration list with reason for other machine down times. According to code list in mcl file. E.g.:"Road travel","Preparing strip roads","Towing other machine","Roadside loading of truck","Unspecified"" </doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
				<xsd:attribute name="otherWorkCategoryName" type="xsd:string">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>free text</doc:Unit>
							<doc:Description>Descriptive name per other work category codes. According to code list in mcl file.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="MaintenanceType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>MaintenanceTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="MaintenanceStandardCode">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>4.0</doc:VersionModified>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration list with maintenance reasons. According to code list in mcl file.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="xsd:string">
							<xsd:attribute name="maintenanceStandardName" type="xsd:string">
								<xsd:annotation>
									<xsd:documentation>
										<doc:VersionCreated>4.0</doc:VersionCreated>
										<doc:Unit>free text</doc:Unit>
										<doc:Description>Descriptive name per down time codes. According to code list in mcl file.
</doc:Description>
									</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="MaintenanceManufacturerCode" type="ManufacturerCodeType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Manufacturer or user defined maintenance reasons</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="ManufacturerCodeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>ManufacturerCodeTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Code" type="xsd:integer">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Manufacturer or user defined codes</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CodeDescription" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Manufacturer or user defined code descriptions.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MonitoringSettingsType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>MonitoringSettingsTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="MonitoringFilterTimeDown" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V315_t1</doc:VarNumber>
						<doc:Unit>seconds</doc:Unit>
						<doc:Description>Down-filter-time, maximum time allowed for a down time, if down time is longer it will be recorded in MachineDownTime. Default value is 900 s (15 min). The value rules the data in MonitoringFilterTimeMinimum</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringFilterTimeRun" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V315_t2</doc:VarNumber>
						<doc:Unit>seconds</doc:Unit>
						<doc:Description>Run-filter-time, A Main work time (Processing, Terrain travel, Other work or Road travel) in MachineWorkTime, must exceed this filter time in order to be registered as a new Main work time.. Default value is 120 s (2 min). This means e.g. that a run time shorter than this will be considered to be of the same type of time as the previously registered time.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringFilterTimeMinimum" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V315_t3</doc:VarNumber>
						<doc:Unit>seconds</doc:Unit>
						<doc:Description>Minimum-filter-time: Smallest considered time unit. If any time (run time or down time) is shorter it is considered non-existing. Default value is 15 s. This means for example that a down time shorter than this is included in the E0-time, if longer it will not be included in the E0-time</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringSettingsKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per monitoring settings</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="MonitoringTimeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>monitoringtimetypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OperatorKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine unique operator identity, set by machine</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ObjectKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting object. Set when new harvesting object is started. Running no recommended, reset only when MachineKey is changed</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SubObjectKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting sub object, set by machine. Set when new harvesting sub object is started. Running no recommended, reset when ObjectKey is updated.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringStartTime" type="StanForD2010DateTimeType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Start time for a time interval. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringTimeLength" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>seconds</doc:Unit>
						<doc:Description>Extension of a time interval </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="MonitoringTimeDescription" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.3</doc:VersionCreated>
						<doc:Description>Free text created by operator per IndividualMachineWorkTime</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CodeListKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per code list set by machine. Must be updated if any modifications to code lsit definition is done. Running number reset only when MachineKey is changed.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="OperationalMonitoringType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>operationalmonitoringtypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OperationalMonitoringHeader" type="MessageHeaderType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>General information for message</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Machine" type="MachineOperationalMonitoringType" maxOccurs="unbounded">
