					<xsd:documentation>
						<doc:VersionCreated>2.0</doc:VersionCreated>
						<doc:VarNumber>v329_t4</doc:VarNumber>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Shift type allowed values are: "Not defined", "Morning", "Day", "Evening" and "Night" </doc:Description>
