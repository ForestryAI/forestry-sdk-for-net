<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="urn:skogforsk:stanford2010" xmlns:doc="urn:skogforsk:stanford2010:doc" xmlns:sfd="urn:skogforsk:stanford2010" targetNamespace="urn:skogforsk:stanford2010" elementFormDefault="qualified" attributeFormDefault="unqualified" version="release_4.1" sfd:versionDate="2025-02-05">
	<!-- ===== Includes ===== -->
	<xsd:include schemaLocation="StanForD2010CommonDefinitions_V4p1.xsd"/>
	<!-- ===== Root Element ===== -->
	<xsd:element name="ObjectInstruction" type="ObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Description>The root element of the Object Product Instruction message</doc:Description>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:unique name="UniqueObjectUserID">
			<xsd:selector xpath="sfd:ObjectDefinition"/>
			<xsd:field xpath="sfd:ObjectUserID"/>
		</xsd:unique>
	</xsd:element>
	<!-- ===== Type Definitions ===== -->
	<xsd:complexType name="DiameterSectionDefinitionObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>DiameterSectionDefinitionObjectInstructionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="DiameterSectionDefinitionType">
				<xsd:sequence>
					<xsd:element name="SpeciesGroupUserID" type="UserIDType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VarNumber>v120_t3</doc:VarNumber>
								<doc:Unit>free text</doc:Unit>
								<doc:Description>Identity per species group defined by user of data, normally by  logging organisation. Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *,+.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="DiameterSectionDefinitionsObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>DiameterSectionDefinitionsObjectInstructionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DiameterSectionDefinition" type="DiameterSectionDefinitionObjectInstructionType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Description>Structure for diameter section specific data</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="modificationRestricted" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>4.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>if attributes value is "true" then modification of the DiameterSectionDefinitions is restricted, if "false" then modification is allowed</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="ObjectDefinitionObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>ObjectDefinitionObjectInstructionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="ObjectDefinitionType">
				<xsd:sequence>
					<xsd:element name="ProductUserIDs" type="ProductUserIDsType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>List of ProductUserIDs that are used in this Object</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="DiameterSectionUserID" type="UserIDType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VarNumber>V531_t2</doc:VarNumber>
								<doc:Unit>free text</doc:Unit>
								<doc:Description>Identity per diameter sections defined by user of data, normally logging organisation Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *,+.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="DiameterSectionDefinitions" type="DiameterSectionDefinitionsObjectInstructionType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description/>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="BarkReference" type="BarkReferenceType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>Structure for referencing which bark function to use at specific object.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="ObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>ObjectInstructionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ObjectInstructionHeader" type="MessageHeaderType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>General information for message</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ObjectDefinition" type="ObjectDefinitionObjectInstructionType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Structure for object specific data</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:keyref name="DiameterSectionUserIDKeyRefObjectDefinition" refer="DiameterSectionUserIDKeyDiameterSectionDefinition">
					<xsd:selector xpath="sfd:DiameterSectionUserID"/>
					<xsd:field xpath="."/>
				</xsd:keyref>
				<xsd:key name="DiameterSectionUserIDKeyDiameterSectionDefinition">
					<xsd:selector xpath="sfd:DiameterSectionDefinitions/sfd:DiameterSectionDefinition"/>
					<xsd:field xpath="sfd:DiameterSectionUserID"/>
				</xsd:key>
				<xsd:unique name="UniqueProductUserID">
					<xsd:selector xpath="sfd:ProductUserIDs/sfd:ProductUserID"/>
					<xsd:field xpath="."/>
				</xsd:unique>
				<xsd:unique name="UniqueSubObjectUserID">
					<xsd:selector xpath="sfd:SubObject"/>
					<xsd:field xpath="sfd:SubObjectUserID"/>
				</xsd:unique>
				<xsd:unique name="UniqueSpeciesGroupUserID">
					<xsd:selector xpath="sfd:BarkReference"/>
					<xsd:field xpath="sfd:SpeciesGroupUserID"/>
				</xsd:unique>
				<xsd:unique name="UniqueBarkFunctionUserID">
					<xsd:selector xpath="sfd:BarkReference"/>
					<xsd:field xpath="sfd:BarkFunctionUserID"/>
				</xsd:unique>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="messageType" type="MessageCategoryType" use="required" fixed="oin">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>1.0</doc:VersionCreated>
					<doc:Unit>list</doc:Unit>
					<doc:Description>Enumeration list of file extensions of StanForD 2010 messages: Allowed value in Object Instruction message is: "oin"</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attributeGroup ref="MessageAttributeGroup"/>
	</xsd:complexType>
	<xsd:complexType name="ProductUserIDsType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>ProductUserIDsTypeTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ProductUserID" type="ProductUserIDType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V121_t2</doc:VarNumber>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Identity per product defined by user of data, normally logging organisation Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *,+.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="modificationRestricted" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>4.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>if attributes value is "true" then modification of the ProductUserIDs restricted, if "false" then modification is allowed</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="ProductUserIDType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>ProductUserIDTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="UserIDType">
				<xsd:attribute name="textToMachine" type="xsd:string">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>free text</doc:Unit>
							<doc:Description>Text related to product referenced in oin.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="SubObjectDefinitionObjectInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>SubObjectDefinitionObjectInstructionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="SubObjectDefinitionType"/>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:simpleType name="DistributionMethodType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Adaptive"/>
			<xsd:enumeration value="Near optimal"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
