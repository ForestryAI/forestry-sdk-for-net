<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="urn:skogforsk:stanford2010" xmlns:doc="urn:skogforsk:stanford2010:doc" xmlns:sfd="urn:skogforsk:stanford2010" targetNamespace="urn:skogforsk:stanford2010" elementFormDefault="qualified" attributeFormDefault="unqualified" version="release_4.1" sfd:versionDate="2025-02-05">
	<!-- ===== Includes ===== -->
	<xsd:include schemaLocation="StanForD2010CommonDefinitions_V4p1.xsd"/>
	<!-- ===== Root Element ===== -->
	<xsd:element name="FelledBunchedProduction" type="FelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Description>The root element of the Felled Bunched Production message</doc:Description>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:unique name="UniqueMachineKey">
			<xsd:selector xpath="sfd:Machine"/>
			<xsd:field xpath="sfd:MachineKey"/>
		</xsd:unique>
		<xsd:unique name="UniqueMachineUserID">
			<xsd:selector xpath="sfd:Machine"/>
			<xsd:field xpath="sfd:MachineUserID"/>
		</xsd:unique>
	</xsd:element>
	<!-- ===== Type Definitions ===== -->
	<xsd:complexType name="DataTableGroupFelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>DataTableGroupFelledBunchedProductionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="DataTableGroupType">
				<xsd:sequence>
					<xsd:element name="ObjectKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per harvesting object. Set when new harvesting object is started. Running no recommended, reset only when MachineKey is changed</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="FelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>FelledBunchedProductionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="FelledBunchedProductionHeader" type="MessageHeaderType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>General information for message</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Machine" type="MachineFelledBunchedProductionType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.5</doc:VersionCreated>
						<doc:Description>All the product specific data is included under Machine elements</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:unique name="UniqueStemNumber">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:StemNumber"/>
					<xsd:field xpath="sfd:ObjectKey"/>
				</xsd:unique>
				<xsd:key name="StemKeyStemFelledBunchedProduction">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:StemKey"/>
				</xsd:key>
				<xsd:unique name="UniqueOperatorUserID">
					<xsd:selector xpath="sfd:OperatorDefinition"/>
					<xsd:field xpath="sfd:OperatorUserID"/>
				</xsd:unique>
				<xsd:unique name="UniqueObjectUserID">
					<xsd:selector xpath="sfd:ObjectDefinition"/>
					<xsd:field xpath="sfd:ObjectUserID"/>
				</xsd:unique>
				<xsd:key name="SpeciesGroupKeySpeciesGroupDefinition">
					<xsd:selector xpath="sfd:SpeciesGroupDefinition"/>
					<xsd:field xpath="sfd:SpeciesGroupKey"/>
				</xsd:key>
				<xsd:keyref name="SpeciesGroupKeyRefStem" refer="SpeciesGroupKeySpeciesGroupDefinition">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:SpeciesGroupKey"/>
				</xsd:keyref>
				<xsd:key name="OperatorKeyOperatorDefinition">
					<xsd:selector xpath="sfd:OperatorDefinition"/>
					<xsd:field xpath="sfd:OperatorKey"/>
				</xsd:key>
				<xsd:keyref name="OperatorKeyRefStem" refer="OperatorKeyOperatorDefinition">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:OperatorKey"/>
				</xsd:keyref>
				<xsd:key name="ObjectKeyObjectDefinition">
					<xsd:selector xpath="sfd:ObjectDefinition"/>
					<xsd:field xpath="sfd:ObjectKey"/>
				</xsd:key>
				<xsd:keyref name="ObjectKeyRefStem" refer="ObjectKeyObjectDefinition">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:ObjectKey"/>
				</xsd:keyref>
				<xsd:keyref name="ObjectKeyRefUserDefinedData" refer="ObjectKeyObjectDefinition">
					<xsd:selector xpath="sfd:UserDefinedData/sfd:DataTableGroup"/>
					<xsd:field xpath="sfd:ObjectKey"/>
				</xsd:keyref>
				<xsd:keyref name="OperatorKeyRefRow" refer="OperatorKeyOperatorDefinition">
					<xsd:selector xpath="sfd:UserDefinedData/sfd:DataTableGroup/sfd:DataTable/sfd:Row"/>
					<xsd:field xpath="sfd:OperatorKey"/>
				</xsd:keyref>
				<xsd:key name="TrackingKeyTrackCoordinates">
					<xsd:selector xpath="sfd:TrackCoordinates"/>
					<xsd:field xpath="sfd:TrackingKey"/>
				</xsd:key>
				<xsd:keyref name="ObjectKeyRefTrackCoordinates" refer="ObjectKeyObjectDefinition">
					<xsd:selector xpath="sfd:TrackCoordinates"/>
					<xsd:field xpath="sfd:ObjectKey"/>
				</xsd:keyref>
				<xsd:keyref name="StemKeyRefTrackCoordinates" refer="StemKeyStemFelledBunchedProduction">
					<xsd:selector xpath="sfd:TrackCoordinates"/>
					<xsd:field xpath="sfd:StemKey"/>
				</xsd:keyref>
				<xsd:unique name="UniquePileNumber">
					<xsd:selector xpath="sfd:PileDefinition"/>
					<xsd:field xpath="sfd:PileNumber"/>
				</xsd:unique>
				<xsd:key name="PileKeyPileDefinition">
					<xsd:selector xpath="sfd:PileDefinition"/>
					<xsd:field xpath="sfd:PileKey"/>
				</xsd:key>
				<xsd:keyref name="PileKeyRefPileDefinition" refer="PileKeyPileDefinition">
					<xsd:selector xpath="sfd:Stem"/>
					<xsd:field xpath="sfd:PileKey"/>
				</xsd:keyref>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="messageType" type="MessageCategoryType" use="required" fixed="bpr">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>1.0</doc:VersionCreated>
					<doc:Unit>list</doc:Unit>
					<doc:Description>Enumeration list of file extensions of StanForD 2010 messages: Allowed value in felled bunched production message is: "bpr"</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attributeGroup ref="MessageAttributeGroup"/>
	</xsd:complexType>
	<xsd:complexType name="MachineFelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>MachineFelledBunchedProductionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="MachineWithAttachmentType">
				<xsd:sequence>
					<xsd:element name="SpeciesGroupDefinition" type="SpeciesGroupDefinitionWithDBHAndKeyType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VersionModified>2.0</doc:VersionModified>
								<doc:Description>Definition of species used in this production message</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="StemVolumeTableDefinition" type="StemVolumeTableDefinitionWithKeyType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Description>Structure for stem volume tables used by e.g. feller-buncher</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ObjectDefinition" type="ObjectDefinitionMachineType" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for object specific data</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueSubObjectKeyFelledBunchedProduction">
							<xsd:selector xpath="SubObject"/>
							<xsd:field xpath="SubObjectKey"/>
						</xsd:unique>
						<xsd:unique name="UniqueSubObjectUserIDInBpr">
							<xsd:selector xpath="SubObject"/>
							<xsd:field xpath="SubObjectUserID"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="PileDefinition" type="PileDefinitionType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.1</doc:VersionCreated>
								<doc:Description>A list of piles of felled stems created by a feller-buncher. Can be used for estimating number and position of piles. Only the first stem could have a reference to a pile in cases when only the first stem is registered manually simultaneously with placing the first stem in the pile.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="Stem" type="StemFelledBunchedProductionType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>A list of harvested stems</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="UserDefinedData" type="UserDefinedDataFelledBunchedProductionType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>2.1</doc:VersionCreated>
								<doc:Description>Structure for user defined data</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueTableGroupIDInBpr">
							<xsd:selector xpath="sfd:DataTableGroup"/>
							<xsd:field xpath="@tableGroupID"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="TrackCoordinates" type="TrackCoordinatesWithStemKeyType" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.3</doc:VersionCreated>
								<doc:VersionModified>4.0</doc:VersionModified>
								<doc:Description>Structure for tracking coordinates registered with a constant distance (e.g. every 10 m) or time  interval  (e.g. every 30 seconds) </doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="PileDefinitionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.1</doc:VersionCreated>
				<doc:Graph>PileDefinitionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="PileKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.1</doc:VersionCreated>
						<doc:Unit>no</doc:Unit>
						<doc:Description>Machine specific identity per pile. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed. It does not have to be a sequential number always incremented with one for each pile.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PileNumber" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.1</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Pile number. A running / sequential number only to be reset when starting on a new harvesting object. </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="CreationDate" type="StanForD2010DateTimeType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.1</doc:VersionCreated>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Time and date for creating a new pile. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PileCoordinate" type="CoordinatesType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>2.0</doc:VersionModified>
						<doc:Description>Pile coordinates, describes the location of the stem pile.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemFelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>StemFelledBunchedProductionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="StemType">
				<xsd:sequence>
					<xsd:choice>
						<xsd:element name="SingleTreeFelledStem" type="SingleTreeFelledStemType" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>
									<doc:VersionCreated>1.0</doc:VersionCreated>
									<doc:Description>Structure for single felled stem</doc:Description>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="MultiTreeFelledStem" type="MultiTreeFelledStemType">
							<xsd:annotation>
								<xsd:documentation>
									<doc:VersionCreated>1.0</doc:VersionCreated>
									<doc:Description>Structure for multi felled stem</doc:Description>
								</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
					</xsd:choice>
					<xsd:element name="PileKey" type="KeyType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.1</doc:VersionCreated>
								<doc:Unit>no</doc:Unit>
								<doc:Description>Machine specific identity per pile. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed. It does not have to be a sequential number always incremented with one for each pile.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="StemVolumeTableDefinitionWithKeyType">
		<xsd:complexContent>
			<xsd:extension base="StemVolumeTableDefinitionType">
				<xsd:sequence>
					<xsd:element name="VolumeTableKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per volume table set by machine. Must be updated if any modifications to volume table definition is done. Running number reset only when MachineKey is changed.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="UserDefinedDataFelledBunchedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>2.1</doc:VersionCreated>
				<doc:Graph>UserDefinedDataHarvestedProductionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DataTableGroup" type="DataTableGroupFelledBunchedProductionType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>2.1</doc:VersionCreated>
						<doc:Description>Structure for user defined data table group</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:unique name="UniqueTableIDFelledBunchedProduction">
					<xsd:selector xpath="sfd:DataTable"/>
					<xsd:field xpath="@tableID"/>
				</xsd:unique>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
