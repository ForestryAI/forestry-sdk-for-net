			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionWithDBHAndKeyTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="SpeciesGroupDefinitionWithDBHType">
				<xsd:sequence>
					<xsd:element name="SpeciesGroupKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.5</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per species group set by machine. Must be updated if any modifications to species group definition is done. Running number reset only when MachineKey is changed.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="SpeciesGroupDefinitionWithDetailsAndBarkFunctionAndKeyType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionWithDetailsAndBarkFunctionAndKeyTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="SpeciesGroupDefinitionWithDetailsType">
				<xsd:sequence>
					<xsd:element name="BarkFunction" type="BarkFunctionWithKeyType" nillable="true" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for bark settings per species group.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SpeciesGroupKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per species group set by machine. Must be updated if any modifications to species group definition is done. Running number reset only when MachineKey is changed.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="SpeciesGroupDefinitionWithDetailsAndBarkFunctionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionWithDetailsAndBarkFunctionTyegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="SpeciesGroupDefinitionWithDetailsType">
				<xsd:sequence>
					<xsd:element name="BarkFunction" type="BarkFunctionType" nillable="true" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for bark settings per species group.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="SpeciesGroupDefinitionWithDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.0</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionWithDetailsTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="CommonSpeciesGroupDefinitionType">
				<xsd:sequence>
					<xsd:element name="DBHHeight" type="DBHHeightType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:VarNumber>v500_t1</doc:VarNumber>
								<doc:Unit>cm</doc:Unit>
								<doc:Description>Height above stump of DBH, when DBH is a measured value (normally 120 cm above stump in Sweden, 110cm in Norway), per species group.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="Grades" type="GradesType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure with alla grade data per species group</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SoundKnotFunction" type="SoundKnotFunctionType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Sound knot function used when calculating the diameter (ob) of the sound knot limit/cylinder. Soundknot function must be used if this structure is included. Observe that all diameters are over bark. </doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ButtEndProfileExtrapolation" type="ButtEndProfileExtrapolationType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for butt end profile extrapolation method. Extrapolation method must be used if this structure is included in spi. Extrapolation method must be used also in cases where you get measurement values below breast height (normally 130 cm).</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="EstonianVolumeParameters" type="EstonianVolumeParametersType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>2.0</doc:VersionCreated>
								<doc:Description>Structure for parameters used in Estonian function for volume calculation. This function is also called  Nilson's formula. See appendix</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="StemCodes" type="StemCodesType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.0</doc:VersionCreated>
								<doc:Unit>Free text</doc:Unit>
								<doc:Description>List of stem codes to be registered manually by operator in harvester in element StemCode in hpr-message. No default value can be set. Code only to be used for small subset of harvested trees.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="ButtLogMAXStartHeight" type="xsd:nonNegativeInteger" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.6</doc:VersionCreated>
								<doc:Unit>cm</doc:Unit>
								<doc:Description>Defines the maximum start height where a log is to be considered. E.g. if this value is 100 cm all logs having their butt cut below100 cm must be considered a butt log. This element has an effect if BuckingCondition has value "Buck butt-log only" or "Do not buck butt log"</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="SpeciesGroupDefinitionWithKeyType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>SpeciesGroupDefinitionWithKeyTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="CommonSpeciesGroupDefinitionType">
				<xsd:sequence>
					<xsd:element name="SpeciesGroupKey" type="KeyType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Unit>sequential no</doc:Unit>
								<doc:Description>Machine specific identity per species group set by machine. Must be updated if any modifications to species group definition is done. Running number reset only when MachineKey is changed.</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="StemCodesType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemCodesTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemCode" type="StemCodeSpeciesGroupDefinitionType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Stem code registered manually by operator in harvester. Only codes that are defined here  can be selected by operator.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="modificationRestricted" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>3.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>if attributes value is "true" then modification of the definition is restricted, if "false" then modification is allowed</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="StemCodeHarvestedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemCodeharvestedProductionType.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="xsd:string">
				<xsd:attribute name="stemCodeInfo" type="xsd:string">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>free text</doc:Unit>
							<doc:Description>Iidentity information for each stem code. Identity element normally to be used by logging organization. No constraints in standard concerning how to use this element.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
				<xsd:attribute name="stemCodeGroup" type="StemCodeGroupType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Standardized enumeration list for grouping stem codes. Can be used in GIS interface.
-Nature (high stumps, retention trees etc)
-Culture (ruin, foot path etc)
-Special harvesting (selective cutting, windthrow, snow breakage etc)
-Other  
Allowed values: "Nature", "Culture", “Special harvesting” and “Other”
</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="StemCodeSpeciesGroupDefinitionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemCodeSpeciesGroupDefinitionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="xsd:string">
				<xsd:attribute name="stemCodeInfo" type="xsd:string" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>free text</doc:Unit>
							<doc:Description>Iidentity information for each stem code. Identity element normally to be used by logging organization. No constraints in standard concerning how to use this element.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
				<xsd:attribute name="stemCodeGroup" type="StemCodeGroupType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Standardized enumeration list for grouping stem codes. Can be used in GIS interface.
-Nature (high stumps, retention trees etc)
-Culture (ruin, foot path etc)
-Special harvesting (selective cutting, windthrow, snow breakage etc)
-Other  
Allowed values: "Nature", "Culture", “Special harvesting” and “Other”
</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="StemDiametersType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>stemdiameterstypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DiameterMeasuredStartHeight" type="xsd:nonNegativeInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>v271_t3</doc:VarNumber>
						<doc:Unit>cm</doc:Unit>
						<doc:Description>Height from stump to first measured diameter in DiameterValue (stem diameter vector).</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DiameterMeasuredEndHeight" type="xsd:nonNegativeInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>v272_t3</doc:VarNumber>
						<doc:Unit>cm</doc:Unit>
						<doc:Description>Height from stump to last measured diameter in DiameterValue (stem diameter vector).</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DiameterVector" type="DiameterVectorType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>v273</doc:VarNumber>
						<doc:Unit>mm</doc:Unit>
						<doc:Description>Diameter at heights defined by diameterPosition attribute (representing the actual point of measuring). Refers to filtered values on bark. Same values as used in bucking optimisation and calculations of solid volumes. No systematic error when comparing log volumes and volume calculations based on DiamValue. Diameter values must start at heighet 0 cm from stump. Extrapolated diameters at butt end are to be registered. Height of first and last measured diameter registered in DiameterMeasuredStart and DiameterMeasuredLast</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="diameterCategory" type="DiameterCategoryType" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>1.0</doc:VersionCreated>
					<doc:Unit>list</doc:Unit>
					<doc:Description>Measured diameter type. Enumeration value: over bark </doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="StemGradeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>stemgradetypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="GradeValue" type="GradeValueType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V276_t1</doc:VarNumber>
						<doc:Unit> </doc:Unit>
						<doc:Description>Grade of stem,</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemHarvestedProductionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>stemharvestedproductiontypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="StemType">
				<xsd:choice>
					<xsd:element name="SingleTreeProcessedStem" type="SingleTreeProcessedStemType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for single processed stem</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueSingleTreeProcessedStemLogKeyStemHarvestedProduction">
							<xsd:selector xpath="sfd:Log"/>
							<xsd:field xpath="sfd:LogKey"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="MultiTreeProcessedStem" type="MultiTreeProcessedStemType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for multi tree processed stem</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
						<xsd:unique name="UniqueMultiTreeProcessedStemLogKeyStemHarvestedProduction">
							<xsd:selector xpath="sfd:Log"/>
							<xsd:field xpath="sfd:LogKey"/>
						</xsd:unique>
					</xsd:element>
					<xsd:element name="SingleTreeFelledStem" type="SingleTreeFelledStemType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for single felled stem</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="MultiTreeFelledStem" type="MultiTreeFelledStemType">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>1.0</doc:VersionCreated>
								<doc:Description>Structure for multi felled stem</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:choice>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="StemLoadEstimationType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>StemLoadEstimationTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemLoadEstimationMethod" type="StemLoadEstimationMethodType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration value describing how skidder or yarder production data was generated per load. Allowed values are: "Manual estimation by operator", "Scale", "Estimation through Harvested Production message" and "Other"</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemLoadEstimationUnit" type="StemLoadEstimationUnitType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Enumeration value describing the unit wich was estimated by operator or measured by machine (not calculated by machine) per load. Allowed values are: "Volume, m3sob", "Volume, m3sub", "Green mass, kg","Number of stems" and "Solid volume including bark, branches and needles, m3"</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemLoadGreenMassType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>StemLoadGreenMassTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="MassType">
				<xsd:attribute name="stemLoadGreenMassMethod" type="LoadGreenMassMethodType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>3.6</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Allowed values: "Loading", "Unloading"</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="StemLoadType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>StemLoadTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemLoadKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per stem load. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="OperatorKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine unique operator identity, set by machine</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemLoadNumber" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>no</doc:Unit>
						<doc:Description>Stem load number. Several PartialStemLoads registered per Load when co-loading is carried out. StemLoadNumber should be reset when starting at new harvesting object.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DistanceFromLastUnloading" type="xsd:nonNegativeInteger" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>m</doc:Unit>
						<doc:Description>Driven distance from last time of unloading (when load space of machine was emptied). Registered when unloading present stem load. Distance from start of harvesting object is registered for first load. Measured by odometer or gps.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="UnloadingTime" type="StanForD2010DateTimeType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Date and Time when load was unloaded by skidder. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ExtractionMethod">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>enumeration list</doc:Unit>
						<doc:Description>Type of extraction method. Skidders can be equipped with winch (choker) and/or grapple.  Allowed values are: "Grapple" or "Choker"</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="Grapple"/>
						<xsd:enumeration value="Choker"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="StemPresentation">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Unit>enumeration list</doc:Unit>
						<doc:Description>Type of stem presentation which describes how stems are positioned before being picked up by skidder.  Allowed values are: "Un-bunched", "Part bunched", "Bunched" or "Machine fed". Un-bunched means stems are generally not grouped, e.g. felled with chainsaw. Part bunched means stems are roughly grouped, e.g. felled with dangle head feller buncher. Bunched means stems are precisely grouped, e.g. felled using a fixed head feller buncher. Machine Fed means stems are placed or lifted by a separate machine into the grapple or for the grapple to grab. </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="Un-bunched"/>
						<xsd:enumeration value="Part bunched"/>
						<xsd:enumeration value="Bunched"/>
						<xsd:enumeration value="Machine fed"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Estimation" type="StemLoadEstimationType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Description>Defines primary unit of skidder production.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PartialStemLoad" type="PartialStemLoadType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.6</doc:VersionCreated>
						<doc:Description>Structure for partial stem load data. Multiple occurences when coloading.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemLoadVolumeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>LoadVolumeTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="VolumeType">
				<xsd:attribute name="stemLoadVolumeCategory" type="StemLoadVolumeCategoryType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>3.6</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Enumeration values defining the actual content of the element.  Allowed values are: "Volume, m3sob", "Volume, m3sub", "Solid volume including bark, branches and needles, m3"</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="StemType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>stemtypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>no</doc:Unit>
						<doc:Description>Machine specific identity per stem. Must be totally unique for a certain MachineKey. Reset only when MachineKey is changed. It does not have to be a sequential number always incremented with one for each stem.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ObjectKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting object. Set when new harvesting object is started. Running no recommended, reset only when MachineKey is changed.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SubObjectKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per harvesting sub object, set by machine. Set when new harvesting sub object is started. Running no recommended, reset when ObjectKey is updated.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SpeciesGroupKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per species group set by machine. Must be updated if any modifications to species group definition is done. Running number reset only when MachineKey is changed.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="OperatorKey" type="KeyType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V266_t1(750) </doc:VarNumber>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine unique operator identity, set by machine</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="HarvestDate" type="StanForD2010DateTimeType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Date when stem was harvested (identical with M1-measurement). Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BioEnergyAdaption" type="BioEnergyAdaptionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V266_t1(505)</doc:VarNumber>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Adaption of harvesting for retrieving bio energy products, in other words whether extraction of logging residues for bio energy purposes is suitable. Allowed enumeration values: "Logging residues", "Stumps", "Logging residues and stumps"</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemNumber" type="xsd:positiveInteger">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V270</doc:VarNumber>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Stem number. A running / sequential number only to be reset when starting on a new harvesting object. (Old stem code 500 in v266)</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ProcessingCategory" type="ProcessingCategoryType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>list</doc:Unit>
						<doc:Description>Possible enumeration values are: SingleTreeProcessing,MultiTreeProcessing,  SingleTreeFelling and MultiTreeFelling</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemCoordinates" type="CoordinatesType" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VersionModified>2.0</doc:VersionModified>
						<doc:Description>Stem coordinates, describes the location of the standing tree.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemCode" type="StemCodeHarvestedProductionType" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.0</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Stem code registered manually by operator in harvester. Only codes included in Spi elements StemCode can be selected by operator.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StumpTreatment" type="xsd:boolean" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.0</doc:VersionCreated>
						<doc:Unit>true/false</doc:Unit>
						<doc:Description>Element indicating if stump was treated with fungicide or herbicide during felling of tree.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BoomPositioning" type="BoomPositioningType" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.2</doc:VersionCreated>
						<doc:Description>Information used to calculate position of harvester head based on angle and extension of boom.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BarkFunctionKey" type="KeyType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>sequential no</doc:Unit>
						<doc:Description>Machine specific identity per bark function set by machine. Must be updated if any modifications to function is done. Running number reset only when MachineKey is changed.  </doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemTypeDefinitionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>stemtypedefinitiontypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemTypeCode" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V124_t2</doc:VarNumber>
						<doc:Unit>free text (usually finish PMP-codes)</doc:Unit>
						<doc:Description>Code for stem type</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemTypeName" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>V124_t1</doc:VarNumber>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Name/Description of stem type</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="StemVolumeMatrixItemType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemVolumeMatrixItemTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="StemVolume" type="StemVolumeStemVolumeTableInstructionType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>m3</doc:Unit>
						<doc:Description>Volume of stem.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemMass" type="NonNegativeDecimal">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>kg</doc:Unit>
						<doc:Description>Mass of stem</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="dbhLowerLimit" type="xsd:positiveInteger" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>4.0</doc:VersionCreated>
					<doc:Unit>mm</doc:Unit>
					<doc:Description>Lower diameter limit of DBH class.</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="StemVolumeStemVolumeTableInstructionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemVolumeStemVolumeTableInstructionTypgraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="NonNegativeDecimal">
				<xsd:attribute name="stemVolumeCategory" type="StemVolumeCategoryStemVolumeTableInstructionType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Enumeration list:  "m3sobEstimated" =  Estimated volume m3sob, "m3subEstimated" =  Estimated volume m3sub.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="StemVolumeTableDefinitionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>StemVolumeTableDefinitionTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="VolumeTableUserID" type="UserIDType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Identity per volume table defined by user of data, normally by  logging organisation. Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ModificationDate" type="ModificationDateType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>yyyy-mm-ddThh:mm:ss[+|-]hh:mm</doc:Unit>
						<doc:Description>Date and time when volume table definition was last modified. VolumeTableKey updated if modified in machine. Time stamp must have the following times registered: local time ±offset from UTC.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="StemVolumeMatrixItem" type="StemVolumeMatrixItemType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:Description>Price, length distribution, color and limitation for each lenght and diameter class.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SpeciesGroupUserID" type="UserIDType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:VarNumber>v120_t3</doc:VarNumber>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Identity per species group defined by user of data, normally by  logging organisation. Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DiameterAdjustmentMatrixItem" type="DiameterAdjustmentMatrixItemType" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Unit>mm</doc:Unit>
						<doc:Description>Adjustment value for estimating DBH based on measured referenceDiameter. Used in feller bunchers where only reference diameter is measured. 
DBH = referenceDiameter+DiameterAdjustment
</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Extension" type="ExtensionType" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Description>Extension element can include whatever data the users want. The only requirement is that it is well-formed XML i.e. it is tagged</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="modificationRestricted" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>4.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>if attributes value is "true" then modification of the StemVolumeTableDefinition is restricted, if "false" then modification is allowed</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="StemVolumeType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>StemVolumeTypegraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleContent>
			<xsd:extension base="VolumeType">
				<xsd:attribute name="stemVolumeCategory" type="StemVolumeCategoryType" use="required">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Unit>list</doc:Unit>
							<doc:Description>Enumeration list:  "m3sob" = Volume m3sob, "m3sub" =  Volume m3sub, "m3sobEstimated" =  Estimated volume m3sob, "m3subEstimated" =  Estimated volume m3sub.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="SubObjectDefinitionType">
