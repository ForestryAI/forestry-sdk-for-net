	<xsd:complexType name="MachineWithWinchType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.6</doc:VersionCreated>
				<doc:Graph>MachineWithWinchTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="MachineType">
				<xsd:sequence>
					<xsd:element name="WinchModel" type="MachineWinchModelType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>3.6</doc:VersionCreated>
								<doc:Unit>free text</doc:Unit>
								<doc:Description>Winch model. Free text that describes the model of the winch.</doc:Description>
