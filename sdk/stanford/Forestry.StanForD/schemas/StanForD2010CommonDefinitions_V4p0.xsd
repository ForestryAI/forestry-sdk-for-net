							<doc:Unit>mm</doc:Unit>
							<doc:Description>Lower DBH limits per species group: Bark function based on DBH and distance (from stump) classes with fixed bark deductions (double), based on German requirements. </doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:complexType name="BarkFunctionType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>1.0</doc:VersionCreated>
				<doc:Graph>BarkFunctionTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="BarkFunctionUserID" type="UserIDType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Description>Identity per bark function defined by user of data, normally by  logging organisation. Do not use a single space or null value. Do not begin or end with a space. Do not include any of the following characters: Double space, Linefeed, carriage return,%, ?, lt, gt, :, " (double quote), /, \, |, *. Can be referenced in oin when several bark functions are specified per species group in spi.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BarkFunctionName" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Description>Name per bark function</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BarkFunctionInfo" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Description>Free text identity information about product. Identity element normally to be used by logging organization. No constraints in standard concerning how to use this element.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BarkFunctionVersion" type="xsd:string" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>4.0</doc:VersionCreated>
						<doc:Description>Additional identity information of product. Identity element normally to be used by logging organization. No constraints in standard concerning how to use this element.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:choice>
				<xsd:element name="ConsolidatedFunction" type="ConsolidatedFunctionType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>4.0</doc:VersionCreated>
							<doc:Description>Parameters for linear function function dependent on dbh and diameter on bark. dbl bark = a0 + b0*D + b1*D^2 + c0*DBH + c1* DBH ^2 + (d0+d1* DBH) * ln(H)
Replacing both old “Swedish Zacco” and “Skogforsk 2004, Norway spruce”, also possible to use for new logarithmic function and second degree polynomials.
Logarithmic function using a0, c0, c1, d0 and d1
Swedish Zacco using a0 and b0
Skogforsk Norway spruce using a0, b0 and c0
2nd degree polynomial (Austrian) using a0, b0 and b1

</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="MatrixDiameter" type="MatrixDiameterType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Description>Structure for  German bark function parameters. Function based on stem diameters.</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="MatrixDistanceDBH" type="MatrixDistanceDBHType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>3.0</doc:VersionCreated>
							<doc:Description>Structure for German bark function parameters. Function based on DBH and distance from stump</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="NonLinearLatitude" type="NonLinearLatitudeType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>1.0</doc:VersionCreated>
							<doc:Description>Parameters for Skogforsk 2004 Scots pine bark function</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="LogisticDistanceDiameter" type="LogisticDistanceDiameterType">
					<xsd:annotation>
						<xsd:documentation>
							<doc:VersionCreated>3.4</doc:VersionCreated>
							<doc:Description>Parameters for logistic type of bark function
</doc:Description>
						</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
		</xsd:sequence>
		<xsd:attribute name="barkFunctionCategory" type="BarkFunctionCategoryType" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>1.0</doc:VersionCreated>
					<doc:VersionModified>4.0</doc:VersionModified>
					<doc:VarNumber>V113_t7</doc:VarNumber>
					<doc:Unit>list</doc:Unit>
					<doc:Description>Allowed values:"None","Consolidated","MatrixDiameter","MatrixDistanceDBH","NonLinearLatitude" and "Logistic". If this attribute is "None" the BarkFunction element is empty.</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="modificationRestricted" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>1.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>if attributes value is "true" then modification of the defintion is restricted, if "false" then modification is allowed. Should not affect element Latitude used in function “Skogforsk 2004 Scots pine" since it must be settable in the harvester</doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
		<xsd:attribute name="barkFunctionDefault" type="xsd:boolean" use="required">
			<xsd:annotation>
				<xsd:documentation>
					<doc:VersionCreated>4.0</doc:VersionCreated>
					<doc:Unit>true/false</doc:Unit>
					<doc:Description>Attribute defining the default bark function to use in case no BarkReference (BarkFunctionUserID) is included in oin-file. </doc:Description>
				</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
