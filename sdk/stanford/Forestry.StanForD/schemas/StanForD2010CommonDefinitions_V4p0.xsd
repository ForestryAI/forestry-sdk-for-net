	<xsd:complexType name="GISLayerGroupType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>3.5</doc:VersionCreated>
				<doc:Graph>GISLayerGroupTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="GISLayerGroupUserID" type="UserIDType">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.5</doc:VersionCreated>
						<doc:Unit>free text</doc:Unit>
						<doc:Description>Identity per GISLayerGroup defined by user of data, normally logging organisation.</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="GISLAyerGroupName" type="xsd:string">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>3.5</doc:VersionCreated>
