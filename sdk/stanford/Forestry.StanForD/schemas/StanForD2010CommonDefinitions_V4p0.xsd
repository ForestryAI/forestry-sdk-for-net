						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>true/false</doc:Unit>
						<doc:Description>Second color for marking logs</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Color3" type="xsd:boolean">
				<xsd:annotation>
					<xsd:documentation>
						<doc:VersionCreated>1.0</doc:VersionCreated>
						<doc:Unit>true/false</doc:Unit>
						<doc:Description>Third color for marking logs</doc:Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="LogCoordinatesType">
		<xsd:annotation>
			<xsd:documentation>
				<doc:VersionCreated>4.0</doc:VersionCreated>
				<doc:Graph>LogCoordinatesTypeGraph.png</doc:Graph>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="CoordinatesType">
				<xsd:sequence>
					<xsd:element name="LogBearing" type="MachineBearingType" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>
								<doc:VersionCreated>4.0</doc:VersionCreated>
								<doc:Unit>Degrees</doc:Unit>
								<doc:Description>The bearing (0-360 degrees) of the log on the ground. 
The bearing is the direction towards the small end of the log. 
Bearing is registered in degrees where 0º is north, 90° is east, 180° is south and 270° is west.
</doc:Description>
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
