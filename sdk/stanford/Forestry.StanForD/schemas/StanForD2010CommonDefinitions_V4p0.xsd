		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="StemCodeGroupType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Nature"/>
			<xsd:enumeration value="Culture"/>
			<xsd:enumeration value="Special harvesting"/>
			<xsd:enumeration value="Other"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="StemDiameterCategoryType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="DBH"/>
			<xsd:enumeration value="ReferenceDiameter"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="StemLoadEstimationMethodType">
		<xsd:restriction base="xsd:string">
