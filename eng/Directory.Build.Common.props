<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- Kind -->
    <PropertyGroup>
        <!-- Forestry client libraries -->
        <IsClientLibrary Condition="'$(IsClientLibrary)' == '' and $(MSBuildProjectName.StartsWith('Forestry.'))">true</IsClientLibrary>

        <IsTestProject Condition="'$(IsTestProject)' == '' and $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    </PropertyGroup>

    <!-- Defaults -->
    <PropertyGroup>
        <LangVersion>latest</LangVersion>

        <!-- TODO: Disable warnings -->

        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Known vulnerable packages, direct or transitive, fail restore through TreatWarningsAsErrors (eng constitution S1) -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
    </PropertyGroup>

    <!-- TODO: Code analysis rule sets with StyleCop.Analyzers -->
    <PropertyGroup Condition="'$(IsClientLibrary)' == 'true'">
    </PropertyGroup>    

    <!-- Metadata -->
    <PropertyGroup>
        <Company>Forestry</Company>
        <Product>Forestry SDK for .NET</Product>
        <Authors>Coders</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

    <!-- Supported target frameworks: the current LTS, plus the newest release when it is newer;
         a version out of support is dropped (eng constitution, spec 001 R8). Support dates are in global.json -->
    <PropertyGroup>
        <LatestTargetFramework>net10.0</LatestTargetFramework>
        <RequiredTargetFrameworks>$(LatestTargetFramework)</RequiredTargetFrameworks>

        <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <!-- Client libraries -->
    <PropertyGroup Condition="'$(IsClientLibrary)' == 'true'">
        <TurnSharedSources>$(MSBuildThisFileDirectory)/../sdk/turn/Forestry.Turn/src/Shared/</TurnSharedSources>
    </PropertyGroup>
</Project>