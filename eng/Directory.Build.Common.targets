<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- CI packs never collide with a release: 1.0.0-beta.1.ci.42, or 1.0.0-ci.42 (spec 001 P2).
         The SDK's VersionSuffix cannot be used because each .csproj sets Version -->
    <PropertyGroup Condition="'$(VersionSuffixCi)' != ''">
        <_VersionBeforeCi>$(Version)</_VersionBeforeCi>
        <Version Condition="$(_VersionBeforeCi.Contains('-'))">$(_VersionBeforeCi).ci.$(VersionSuffixCi)</Version>
        <Version Condition="!$(_VersionBeforeCi.Contains('-'))">$(_VersionBeforeCi)-ci.$(VersionSuffixCi)</Version>
        <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>

    <!-- Release notes from the package's CHANGELOG.md (eng constitution C1, spec 001 P3). With -p:Release=true the
         version must have a dated heading, "## <Version> (yyyy-MM-dd)", so the same check runs locally and in release.yml -->
    <Target Name="ReadReleaseNotes" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true' and '$(IsShippingLibrary)' == 'true'">
        <PropertyGroup>
            <_ReleaseVersion>$(Version)</_ReleaseVersion>
            <_ReleaseVersion Condition="'$(_VersionBeforeCi)' != ''">$(_VersionBeforeCi)</_ReleaseVersion>
            <_ChangelogPath>$(MSBuildProjectDirectory)/../CHANGELOG.md</_ChangelogPath>
            <_ChangelogText Condition="Exists('$(_ChangelogPath)')">$([System.IO.File]::ReadAllText('$(_ChangelogPath)'))</_ChangelogText>
            <_ReleaseVersionPattern>$([System.Text.RegularExpressions.Regex]::Escape('$(_ReleaseVersion)'))</_ReleaseVersionPattern>
            <_ChangelogHeadingFound>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ChangelogText)', '(?m)^## $(_ReleaseVersionPattern) \('))</_ChangelogHeadingFound>
            <_ChangelogHeadingDated>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ChangelogText)', '(?m)^## $(_ReleaseVersionPattern) \(\d{4}-\d{2}-\d{2}\)'))</_ChangelogHeadingDated>
        </PropertyGroup>

        <Error Condition="'$(Release)' == 'true' and '$(_ChangelogHeadingFound)' != 'True'" Code="FSDK00002"
               Text="FSDK00002: $(_ChangelogPath) has no heading for version $(_ReleaseVersion): expected '## $(_ReleaseVersion) (yyyy-MM-dd)'" />
        <Error Condition="'$(Release)' == 'true' and '$(_ChangelogHeadingFound)' == 'True' and '$(_ChangelogHeadingDated)' != 'True'" Code="FSDK00003"
               Text="FSDK00003: the heading for version $(_ReleaseVersion) in $(_ChangelogPath) has no release date: replace (Unreleased) with (yyyy-MM-dd)" />

        <PropertyGroup Condition="'$(_ChangelogHeadingFound)' == 'True'">
            <PackageReleaseNotes>$([System.Text.RegularExpressions.Regex]::Replace('$(_ChangelogText)', '(?s)\A.*?(?m:^)## $(_ReleaseVersionPattern) \([^)]*\)[^\n]*\n(.*?)(?:(?m:^)## .*)?\z', '$1').Trim())</PackageReleaseNotes>
        </PropertyGroup>

        <WriteLinesToFile Condition="'$(_ChangelogHeadingFound)' == 'True'"
                          File="$(ArtifactsDir)release-notes/$(PackageId).md"
                          Lines="$([MSBuild]::Escape('$(PackageReleaseNotes)'))"
                          Overwrite="true" />
    </Target>

    <Target Name="EnforceCentralPackageManagement" BeforeTargets="Restore;Build;CollectPackageReferences">
        <!-- Guard against disabling CPM -->
        <Error
            Condition="'$(ManagePackageVersionsCentrally)' == 'false'"
            Text="FSDK00001: CPM may not be disabled"
            Code="FSDK00001" />
    </Target>
</Project>